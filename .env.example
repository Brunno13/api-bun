BETTER_AUTH_SECRET=example_secret_key
BETTER_AUTH_URL=http://localhost:3000
DB_FILE_NAME=example.sqlite
DATABASE_URL=

# Configurações do S3 (Garage)
GARAGE_S3_ENDPOINT=http://example.local:3900
GARAGE_S3_ACCESS_KEY_ID=example_access_key_id
GARAGE_S3_SECRET_ACCESS_KEY=example_secret_access_key
GARAGE_S3_BUCKET_NAME=example_bucket
GARAGE_S3_PUBLIC_URL=http://example.local:3902

# Bootstrap inicial do administrador.
# Configure apenas antes da primeira inicialização e remova depois de criar a conta.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start